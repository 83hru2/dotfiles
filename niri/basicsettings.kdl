// Generated by niri-settings - Edits will be overwritten!

// prefer-no-csd

overview {
    zoom 0.4
}

animations {
    on
    slowdown 2.0
}

layout {
    shadow {
        off
    }

    gaps 8
    default-column-display "tabbed"
    center-focused-column "never"
    // empty-workspace-above-first

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    insert-hint {
        // off
        color "#ffc87f70"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 4
        width 4
        length total-proportion=1.0
        gap 4
        gaps-between-tabs 2
    }
}

blur {
    on
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

window-rule {
    match is-active=true
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false

    background-effect {
        blur true

    }

    border {
        off
        width 2
        active-color "#58a6ff"
    }
} 

window-rule {
    match is-active=false
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false

    background-effect {
        blur true
    }

    border {
        off
        width 2
        active-color "#58a6ff00"
    }
}

input {
    // warp-mouse-to-focus
    // focus-follows-mouse // max-scroll-amount="10%"
    // disable-power-key-handling
    // workspace-auto-back-and-forth
    mod-key "Super"

    touchpad {
        tap
        dwt
        // dwtp
        natural-scroll
        drag true
        // drag-lock
        // disabled-on-external-mouse
        // left-handed
        click-method "button-areas"
        scroll-method "two-finger"
        accel-speed 0.25
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        scroll-factor 1.0
    }

    mouse {
        // natural-scroll
        // left-handed
        // middle-emulation
        accel-speed 0.25
        accel-profile "adaptive"
        scroll-factor 1.0
    }

    keyboard {
        track-layout "global"
        numlock
        repeat-delay 600
        repeat-rate 25
        xkb {
            layout "uz_custom,uz_custom"
            variant "basic,rus"
            options "lv3:ralt_switch,grp:win_space_toggle"
        }
    }
}

hotkey-overlay {
    hide-not-bound
    skip-at-startup
}

gestures {
    hot-corners {
        //off
        top-left
    }
}

debug {
    // honor-xdg-activation-with-invalid-serial 
    render-drm-device "/dev/dri/renderD128" 
}

cursor {
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 1000
}

// * do not show backups
